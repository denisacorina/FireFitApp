@page "/menu"
@using Radzen
@using Radzen.Blazor
@inject NavigationManager NavigationManager

<div class="dashboard-container">
    <RadzenRow>
        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard class="dashboard-card" @onclick="@(() => NavigationManager.NavigateTo("/profile"))">
                <RadzenIcon Icon="account_circle" class="dashboard-icon" />
                <h3>My Profile</h3>
                <p>Update your bio, preferences, and photo.</p>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard class="dashboard-card" @onclick="@(() => NavigationManager.NavigateTo("/my-goals"))">
                <RadzenIcon Icon="flag" class="dashboard-icon" />
                <h3>Goals</h3>
                <p>Create and manage your fitness goals.</p>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard class="dashboard-card" @onclick="@(() => NavigationManager.NavigateTo("/progress"))">
                <RadzenIcon Icon="show_chart" class="dashboard-icon" />
                <h3>Progress Tracking</h3>
                <p>Log measurements and monitor growth.</p>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard class="dashboard-card" @onclick="@(() => NavigationManager.NavigateTo("/nutrition-analysis"))">
                <RadzenIcon Icon="restaurant" class="dashboard-icon" />
                <h3>Nutrition Analysis</h3>
                <p>Review meals and macro targets.</p>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard class="dashboard-card" @onclick="@(() => NavigationManager.NavigateTo("/meal-detection"))">
                <RadzenIcon Icon="photo_camera" class="dashboard-icon" />
                <h3>Meal Detection</h3>
                <p>Snap a photo to detect ingredients.</p>
            </RadzenCard>
        </RadzenColumn>

        <RadzenColumn Size="12" SizeMD="6" SizeLG="4">
            <RadzenCard class="dashboard-card" @onclick="@(() => NavigationManager.NavigateTo("/reports-analytics"))">
                <RadzenIcon Icon="analytics" class="dashboard-icon" />
                <h3>Reports & Analytics</h3>
                <p>Discover trends and detailed insights.</p>
            </RadzenCard>
        </RadzenColumn>
    </RadzenRow>
</div>
