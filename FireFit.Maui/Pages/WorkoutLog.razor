@page "/workouts"
@using FireFit.Shared.Contracts
@using FireFit.Shared.DTOs
@using FireFit.UI.Shared.Components.Workouts
@inject IWorkoutSessionService WorkoutService
@using Radzen
@using Radzen.Blazor
@inject IAuthService AuthService
@inject DialogService DialogService
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<div class="p-3">
    <h3 class="mb-3">Workout Log</h3>

    @if (!_loaded)
    {
        <div class="text-center my-4">
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="width: 200px;" />
        </div>
    }
    else if (_userId is null)
    {
        <RadzenAlert Severity="AlertSeverity.Warning">
            Please sign in to track your workouts.
        </RadzenAlert>
    }
    else
    {
        <RadzenButton Text="Log Workout"
                      Icon="add"
                      ButtonStyle="ButtonStyle.Primary"
                      Click="AddWorkout"
                      Style="width: 100%; margin-bottom: 1rem;" />

        @if (_loading)
        {
            <RadzenProgressBar Mode="ProgressBarMode.Indeterminate" Style="width: 100%;" />
        }
        else if (_sessions.Count == 0)
        {
            <RadzenAlert Severity="AlertSeverity.Info">
                You haven't logged any workouts yet. Use the button above to schedule one using your saved preferences.
            </RadzenAlert>
        }
        else
        {
            <RadzenDataList Data="@_sessions" TItem="WorkoutSessionDto" Style="width: 100%;">
                <Template Context="session">
                    <div class="workout-item">
                        <div class="workout-type">@session.WorkoutType</div>
                        <div class="workout-meta">
                            <span>@session.StartTime:MMM dd, HH:mm</span>
                            <span>@session.DurationMinutes min</span>
                            <span>Intensity @session.IntensityLevel</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(session.Notes))
                        {
                            <small class="text-muted">@session.Notes</small>
                        }
                    </div>
                </Template>
            </RadzenDataList>
        }
    }
</div>

@code {
    private readonly List<WorkoutSessionDto> _sessions = new();
    private string? _userId;
    private bool _loaded;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        await EnsureUserAsync();
        if (_userId is not null)
        {
            await LoadAsync();
        }
    }

    private async Task EnsureUserAsync()
    {
        var user = await AuthService.GetCurrentUserAsync();
        if (user is null)
        {
            NavigationManager.NavigateTo("/login");
            return;
        }

        _userId = user.UserId;
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        if (_userId is null)
        {
            return;
        }

        _loading = true;
        StateHasChanged();
        try
        {
            var sessions = await WorkoutService.GetUserSessionsAsync(_userId);
            _sessions.Clear();
            _sessions.AddRange(sessions.OrderByDescending(s => s.StartTime));
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Failed to load workouts", ex.Message);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task AddWorkout()
    {
        if (_userId is null)
        {
            return;
        }

        var result = await DialogService.OpenAsync<AddWorkoutDialog>("Log Workout",
            new Dictionary<string, object> { ["UserId"] = _userId },
            new DialogOptions { Width = "420px", Height = "600px" });

        if (result is true)
        {
            await LoadAsync();
            NotificationService.Notify(NotificationSeverity.Success, "Workout logged!");
        }
    }
}

<style>
    .workout-item {
        padding: 0.75rem 0;
        border-bottom: 1px solid #e9ecef;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }

    .workout-type {
        font-weight: 600;
    }

    .workout-meta {
        display: flex;
        gap: 0.75rem;
        font-size: 0.9rem;
        color: #6c757d;
    }
</style>
