<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>FireFit.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FireFit.App\FireFit.App.csproj" />
    <ProjectReference Include="..\FireFit.AppCore\FireFit.AppCore.csproj" />
    <ProjectReference Include="..\FireFit.Infrastructure\FireFit.Infrastructure.csproj" />
    <ProjectReference Include="..\FireFit.Ui\FireFit.Ui.csproj" />
  </ItemGroup>

</Project>
